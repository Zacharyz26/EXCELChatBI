# ChatBI API 的知识库生产档；通过进程管理器/容器 env-file 注入，不要提交真实 token。
APP_ENV=production
LOG_LEVEL=INFO
AUTH_MODE=bearer
# 通过 secret manager 注入；不要把真实 token 提交到仓库。
AUTH_TOKENS_JSON={"replace-with-long-random-token":{"user_id":"admin","tenant_id":"company","roles":["kb_admin"]}}

DEEPSEEK_API_KEY=replace-with-provider-secret

# 阶段 2E：API 只连接根 Compose 内的五个认证 Streamable HTTP 服务。
AGENT_MCP_TRANSPORT=streamable_http
AGENT_MCP_ALLOW_IN_PROCESS_FALLBACK=false

# 生产 secret 不写入本文件。把以下路径指向部署系统生成的六个独立文件；
# 五个服务 token 不得复用，上下文 HMAC key 也不得与服务 token 相同。
MCP_CONTEXT_SIGNING_KEY_FILE_PATH=/run/deploy-secrets/chatbi-context-hmac
MCP_DATA_TOKEN_FILE_PATH=/run/deploy-secrets/chatbi-data-token
MCP_STATS_TOKEN_FILE_PATH=/run/deploy-secrets/chatbi-stats-token
MCP_CHART_TOKEN_FILE_PATH=/run/deploy-secrets/chatbi-chart-token
MCP_REPORT_TOKEN_FILE_PATH=/run/deploy-secrets/chatbi-report-token
MCP_KNOWLEDGE_TOKEN_FILE_PATH=/run/deploy-secrets/chatbi-knowledge-token

RAG_EMBEDDER=hashing
RAG_RERANKER=lexical
RAG_STORE=local
RAG_RUNTIME_PROFILE=baseline
MILVUS_COLLECTION=kb_chunks

KB_DOCS_DIR=docs/kb_samples
KB_SOURCE_DIR=/var/lib/chatbi/kb/sources
KB_INDEX_DIR=/var/lib/chatbi/kb/index
KB_BACKUP_DIR=/var/lib/chatbi/kb/backups
MODEL_CACHE_DIR=/var/cache/chatbi/models
KB_MAX_FILES=1000
KB_MAX_DOCUMENT_CHARS=2000000
