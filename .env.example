# ChatBI 环境变量样例 —— 复制为 .env 后填写真实值。
# 红线：禁止把真实密钥/连接串/模型名硬编码进代码，一律走此处。
# 模型名集中在 config/models.yaml（model registry），不在业务代码里写死。
#
# 常规应用变量与 packages/common/config.py 的 Settings 字段对应；MCP_* 由独立工具服务入口读取。

# ── 运行环境 ──
APP_ENV=development                     # development | staging | production
PROCESS_ROLE=api                        # api | mcp_server
LOG_LEVEL=INFO

# ── API 认证与项目隔离 ──
# 本地单人开发可 disabled；staging/production 会拒绝以 disabled 启动。
AUTH_MODE=disabled                      # disabled | bearer
# Bearer 模式：token 只由部署 secret 注入，不提交真实值；每个主体固定 tenant/roles。
AUTH_TOKENS_JSON=
# 示例结构（不要原样使用）：
# {"replace-with-32-byte-secret":{"user_id":"alice","tenant_id":"company-a","roles":["kb_admin"]}}
AUTH_DEFAULT_USER_ID=local-user         # 仅 disabled 模式
AUTH_DEFAULT_TENANT_ID=local            # 仅 disabled 模式

# ── 模型路由网关（OpenAI 兼容接口）──
MODEL_REGISTRY_PATH=config/models.yaml
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# 多模态识图：Qwen2.5-VL / GLM-4V（按实际供应商填写 base/key）
VISION_API_BASE=
VISION_API_KEY=

# ── 本地数据落盘（当前存储形态；MinIO/PostgreSQL 未接，见设计文档 5.5）──
DATASET_DIR=.data/datasets
UPLOAD_DIR=.data/uploads
REPORT_DIR=.data/reports
REPORT_TEMP_GRACE_SECONDS=3600
CHAT_DB_PATH=.data/chatbi.db             # 项目/对话/消息/工件 SQLite 真相源
CONVERSATION_CACHE_SIZE=128              # 单进程最近对话 LRU 热缓存容量
CHAT_HISTORY_LIMIT=20                    # 每次模型请求携带的最近消息数
CHAT_PROFILE_MAX_CHARS=12000             # 常驻数据画像最大字符数，超出截断

# ── Agent 循环护栏（阶段3，初值见设计文档 14.5.1，按真实使用调优）──
AGENT_MAX_TOOL_CALLS=12                  # 单轮对话工具调用总数上限（6 会挡掉多指标出图的 3+3+3 计划）
AGENT_TOOL_RESULT_MAX_CHARS=6000         # 工具结果回填模型前的截断上限
AGENT_REGISTRY_MAX_ENTRIES=12            # 分析登记表全量条目上限，更旧的摘要化
AGENT_RUN_TIMEOUT_SECONDS=300            # 单轮任务总墙钟超时
AGENT_MODEL_TIMEOUT_SECONDS=90           # 单次模型流超时
AGENT_TOOL_TIMEOUT_SECONDS=120           # 单次工具超时；超时结果按 unknown 处理
AGENT_RECOVERY_STALE_SECONDS=0           # 启动恢复阈值；单进程部署用 0
# Executor → MCP Client Gateway。in_process 仅限迁移兼容/测试；
# staging/production 必须使用 streamable_http，且禁止进程内降级。
AGENT_MCP_TRANSPORT=in_process           # in_process | stdio | streamable_http
AGENT_MCP_STDIO_COMMAND_JSON=            # 示例：[".venv/bin/python","-m","your_mcp_server"]
AGENT_MCP_STDIO_CWD=
AGENT_MCP_HTTP_URL=                      # 示例：http://data-tools:8000/mcp/
AGENT_MCP_SERVICE_TOKEN=                 # 仅由部署 secret 注入
AGENT_MCP_SERVICE_TOKEN_FILE=            # 单逻辑端点的 secret 文件；与上项二选一
AGENT_MCP_CONTEXT_SIGNING_KEY=           # Host→Server 上下文 HMAC；仅由 secret 注入
AGENT_MCP_CONTEXT_SIGNING_KEY_FILE=       # 推荐容器路径；与上项二选一
# 阶段 2E 五服务路由；启用后必须精确包含 data/stats/chart/report/knowledge 五项。
AGENT_MCP_SERVER_URLS_JSON=
AGENT_MCP_SERVICE_TOKENS_JSON=           # 本地调试可用；生产使用下一项的 secret 文件映射
AGENT_MCP_SERVICE_TOKEN_FILES_JSON=
AGENT_MCP_CONNECT_TIMEOUT_SECONDS=10
AGENT_MCP_MAX_RECONNECTS=1               # 仅只读且幂等工具允许同幂等键重连重试
AGENT_MCP_ALLOW_IN_PROCESS_FALLBACK=false # 仅开发兼容；只读且幂等调用可降级
MAX_UPLOAD_MB=50                        # 上传大小上限（超限 413，防内存 DoS）
LARGE_TABLE_ROW_THRESHOLD=500000        # 超过直接拒绝；大表 DuckDB 分块留后续

# ── MCP 工具服务（每个服务进程独立配置；默认 stdio）──
MCP_TRANSPORT=stdio                     # stdio | streamable-http
MCP_HTTP_HOST=127.0.0.1                 # HTTP 调试默认只绑定 loopback
# MCP_HTTP_PORT 省略时使用各服务内置端口；容器编排应显式覆盖
MCP_SERVICE_TOKEN=                      # HTTP 必填，必须由 secret/部署环境注入
MCP_SERVICE_TOKEN_FILE=                 # 容器推荐；与上项二选一
MCP_CONTEXT_SIGNING_KEY=                # 与 Host 的 AGENT_MCP_CONTEXT_SIGNING_KEY 一致
MCP_CONTEXT_SIGNING_KEY_FILE=           # 容器推荐；与上项二选一
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=                    # 逗号分隔；留空即拒绝所有带 Origin 的请求

# ── 数据画像安全策略（缺失用内置宽松默认）──
DATA_POLICY_PATH=config/data_policy.yaml

# ── 中文 RAG（知识库检索）──
RAG_EMBEDDER=hashing                    # hashing（默认替身）| bge（bge-m3，需 uv sync --extra rag）
RAG_RERANKER=lexical                    # lexical（默认替身）| bge（bge-reranker-v2-m3）
RAG_STORE=local                         # local（JSON 落盘）| milvus（Milvus Lite；应与 bge 配对）
MILVUS_URI=.data/milvus_lite.db         # 本地文件=Milvus Lite；http://host:19530=standalone（只改此处）
MILVUS_TOKEN=                           # Standalone 鉴权 token（user:password）；Lite 留空
MILVUS_COLLECTION=kb_chunks             # 逻辑集合名；重建代际由程序管理，不要手工改后缀集合
EMBEDDING_DEVICE=auto                   # auto | cpu | cuda（决策4：切换不改代码）
RAG_MIN_RELEVANCE=0.0                   # 替身默认；bge 已验收配置使用 0.02（见验收基线文档）
EMBEDDING_DIM=256                       # HashingEmbedder 向量维度
KB_INDEX_DIR=.data/kb_index
KB_DOCS_DIR=docs/kb_samples
KB_BACKUP_DIR=.data/kb_backups             # Local/Lite 离线备份目录
KB_MAX_FILES=1000                       # 单次同步/重建最多读取的文档数
KB_MAX_DOCUMENT_CHARS=2000000           # 单文档字符上限
EMBEDDING_MODEL=BAAI/bge-m3             # HuggingFace 名称或离线权重目录
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 图表服务端截图（留空自动探测已安装的 chromium）──
CHROMIUM_EXECUTABLE_PATH=

# ── 沙箱（红线5，实现选型待确认）──
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512

# ── 预留（Settings 已定义但当前代码未接；接入触发条件见设计文档 13.2）──
REDIS_HOST=127.0.0.1                    # SQLite 已启用；多 worker/多实例时再引入 Redis
REDIS_PORT=6379
SESSION_TTL_SECONDS=3600
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MILVUS_HOST=127.0.0.1                   # 预留；当前 standalone 连接统一使用 MILVUS_URI
MILVUS_PORT=19530
MINIO_ENDPOINT=127.0.0.1:9000
